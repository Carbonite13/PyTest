# configure stun server
# by default it uses the google stun server unless overridden with external server
STUN_SERVER=stun:stun.l.google.com:19302

# Database configurations
DB_HOSTNAME=
DB_PORT=5432
DB_NAME=
DB_PASSWORD=
DB_USERNAME=
DB_EXTERNAL_URL=

# App configurations
# information that will be exposed through the server
# [[ DO NOT SET SENSITIVE CONTACT DETAILS ]]
APP_INFO_NAME=
APP_INFO_VERSION=
APP_INFO_AUTHOR=
APP_INFO_DESCRIPTION=
APP_CONTACT_EMAIL=
APP_CONTACT_PHONE=

# directory configurations
# the app will use the given configurations andd will create
# necessary paths and subsequent features if the permissios allow so
APP_ROOT=
LOG_DIRECTORY=
DATA_DIRECTORY=

# permissions bit
# if set, the application will create the directories mentioned,
# if they aren't present by default
PERM_DIRECTORY_CREATE=
